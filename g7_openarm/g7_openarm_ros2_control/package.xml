<?xml version="1.0"?>
<package format="3">
  <name>g7_openarm_ros2_control</name>
  <version>0.0.1</version>
  <description>ros2_control bringup skeleton for g7_openarm.</description>

  <maintainer email="you@example.com">g7_openarm</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ocs2_core</depend>
  <depend>ocs2_mobile_manipulator</depend>
  <depend>ocs2_pinocchio_interface</depend>
  <depend>ocs2_msgs</depend>
  <depend>pinocchio</depend>
  <depend>rclcpp</depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>g7_openarm_controllers</exec_depend>
  <exec_depend>g7_openarm_description</exec_depend>
  <exec_depend>g7_openarm_hardware_interface</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
