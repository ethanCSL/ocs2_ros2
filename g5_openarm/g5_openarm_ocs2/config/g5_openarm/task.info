; g5_openarm task configuration aligned with g5_openarm.urdf

model_information {
  ; 0: Default-arm, 1: Wheel-based manipulator, 2: Floating-arm manipulator, 3: Fully actuated floating-arm manipulator
  manipulatorModelType 1

  ; joints in the URDF to be treated as fixed for OCS2 model reduction
  removeJoints {
    [0]  "AMR_FL_joint"
    [1]  "AMR_FLW_joint"
    [2]  "AMR_FR_joint"
    [3]  "AMR_FRW_joint"
    [4]  "AMR_RL_joint"
    [5]  "AMR_RLW_joint"
    [6]  "AMR_RR_joint"
    [7]  "AMR_RRW_joint"
    [8]  "gripper_LL_joint"
    [9]  "gripper_LR_joint"
    [10] "gripper_RL_joint"
    [11] "gripper_RR_joint"
  }

  baseFrame "AMR_base_link"
  ; eeFrame/eeFrame1 should target the tool-center links, not wrist link 7.
  eeFrame   "L_ee_link"
  eeFrame1  "R_ee_link"
}

model_settings {
  usePreComputation true
  recompileLibraries true
}

ddp {
  algorithm SLQ

  nThreads 3
  threadPriority 50

  maxNumIterations 1
  minRelCost 0.1
  constraintTolerance 1e-3

  displayInfo false
  displayShortSummary false
  checkNumericalStability false
  debugPrintRollout false
  debugCaching false

  AbsTolODE 1e-5
  RelTolODE 1e-3
  maxNumStepsPerSecond 100000
  timeStep 1e-3
  backwardPassIntegratorType ODE45

  constraintPenaltyInitialValue 20.0
  constraintPenaltyIncreaseRate 2.0

  preComputeRiccatiTerms true
  useFeedbackPolicy false

  strategy LINE_SEARCH
  lineSearch {
    minStepLength 1e-2
    maxStepLength 1.0
    hessianCorrectionStrategy DIAGONAL_SHIFT
    hessianCorrectionMultiple 1e-3
  }
}

rollout {
  AbsTolODE 1e-5
  RelTolODE 1e-3
  timeStep 1e-2
  integratorType ODE45
  maxNumStepsPerSecond 100000
  checkNumericalStability false
}

mpc {
  timeHorizon 1.0
  solutionTimeWindow 0.2
  coldStart false
  debugPrint false
  mpcDesiredFrequency 100
  mrtDesiredFrequency 400
}

initialState {
  base {
    defaultManipulator {
    }

    floatingArmManipulator {
      (0,0) 0.0
      (1,0) 0.0
      (2,0) 0.0
      (3,0) 0.0
      (4,0) 0.0
      (5,0) 0.0
    }

    fullyActuatedFloatingArmManipulator {
      (0,0) 0.0
      (1,0) 0.0
      (2,0) 0.0
      (3,0) 0.0
      (4,0) 0.0
      (5,0) 0.0
    }

    wheelBasedMobileManipulator {
      (0,0) 0.0  ; x
      (1,0) 0.0  ; y
      (2,0) 0.0  ; heading
    }
  }

  ; left arm (0..6), right arm (7..13)
  arm {
    (0,0)   0.0 ; L_1_joint
    (1,0)   0.0 ; L_2_joint
    (2,0)   0.0 ; L_3_joint
    (3,0)   0.0 ; L_4_joint
    (4,0)   0.0 ; L_5_joint
    (5,0)   0.0 ; L_6_joint
    (6,0)   0.0 ; L_7_joint

    (7,0)   0.0 ; R_1_joint
    (8,0)   0.0 ; R_2_joint
    (9,0)   0.0 ; R_3_joint
    (10,0)  0.0 ; R_4_joint
    (11,0)  0.0 ; R_5_joint
    (12,0)  0.0 ; R_6_joint
    (13,0)  0.0 ; R_7_joint
  }
}

inputCost {
  R {
    base {
      defaultManipulator {
      }

      floatingArmManipulator {
      }

      fullyActuatedFloatingArmManipulator {
        scaling 1e-2
        (0,0) 5.0
        (1,1) 5.0
        (2,2) 5.0
        (3,3) 5.0
        (4,4) 5.0
        (5,5) 5.0
      }

      wheelBasedMobileManipulator {
        scaling 1e-2
        (0,0) 2.5 ; forward velocity
        (1,1) 2.5 ; turning velocity
      }
    }

    arm {
      scaling 1e-2
      (0,0)   1.0 ; L_1_joint velocity
      (1,1)   1.0 ; L_2_joint velocity
      (2,2)   1.0 ; L_3_joint velocity
      (3,3)   1.0 ; L_4_joint velocity
      (4,4)   1.0 ; L_5_joint velocity
      (5,5)   1.0 ; L_6_joint velocity
      (6,6)   1.0 ; L_7_joint velocity
      (7,7)   1.0 ; R_1_joint velocity
      (8,8)   1.0 ; R_2_joint velocity
      (9,9)   1.0 ; R_3_joint velocity
      (10,10) 1.0 ; R_4_joint velocity
      (11,11) 1.0 ; R_5_joint velocity
      (12,12) 1.0 ; R_6_joint velocity
      (13,13) 1.0 ; R_7_joint velocity
    }
  }
}

endEffector {
  dualArmMode true
  leftArm {
    muPosition 10.0
    muOrientation 5.0
  }
  rightArm {
    muPosition 10.0
    muOrientation 5.0
  }
}

finalEndEffector {
  dualArmMode true
  leftArm {
    muPosition 10.0
    muOrientation 5.0
  }
  rightArm {
    muPosition 10.0
    muOrientation 5.0
  }
}

selfCollision {
  activate false
}

jointPositionLimits {
  activate true
  mu 0.01
  delta 1e-3
}

jointVelocityLimits {
  mu 0.01
  delta 1e-3

  lowerBound {
    base {
      defaultManipulator {
      }
      floatingArmManipulator {
      }
      fullyActuatedFloatingArmManipulator {
        (0,0) -0.1
        (1,0) -0.1
        (2,0) -0.1
        (3,0) -0.3
        (4,0) -0.3
        (5,0) -0.3
      }
      wheelBasedMobileManipulator {
        (0,0) -1.0 ; forward velocity
        (1,0) -1.5 ; turning velocity
      }
    }

    arm {
      (0,0)  -8.0 ; L_1_joint [rad/s]
      (1,0)  -8.0 ; L_2_joint [rad/s]
      (2,0)  -8.0 ; L_3_joint [rad/s]
      (3,0)  -8.0 ; L_4_joint [rad/s]
      (4,0)  -8.0 ; L_5_joint [rad/s]
      (5,0)  -0.1 ; L_6_joint [rad/s]
      (6,0)  -8.0 ; L_7_joint [rad/s]

      (7,0)  -8.0 ; R_1_joint [rad/s]
      (8,0)  -8.0 ; R_2_joint [rad/s]
      (9,0)  -8.0 ; R_3_joint [rad/s]
      (10,0) -8.0 ; R_4_joint [rad/s]
      (11,0) -8.0 ; R_5_joint [rad/s]
      (12,0) -0.1 ; R_6_joint [rad/s]
      (13,0) -8.0 ; R_7_joint [rad/s]
    }
  }

  upperBound {
    base {
      defaultManipulator {
      }
      floatingArmManipulator {
      }
      fullyActuatedFloatingArmManipulator {
        (0,0) 0.1
        (1,0) 0.1
        (2,0) 0.1
        (3,0) 0.3
        (4,0) 0.3
        (5,0) 0.3
      }
      wheelBasedMobileManipulator {
        (0,0) 1.0 ; forward velocity
        (1,0) 1.5 ; turning velocity
      }
    }

    arm {
      (0,0)   8.0 ; L_1_joint [rad/s]
      (1,0)   8.0 ; L_2_joint [rad/s]
      (2,0)   8.0 ; L_3_joint [rad/s]
      (3,0)   8.0 ; L_4_joint [rad/s]
      (4,0)   8.0 ; L_5_joint [rad/s]
      (5,0)   0.1 ; L_6_joint [rad/s]
      (6,0)   8.0 ; L_7_joint [rad/s]

      (7,0)   8.0 ; R_1_joint [rad/s]
      (8,0)   8.0 ; R_2_joint [rad/s]
      (9,0)   8.0 ; R_3_joint [rad/s]
      (10,0)  8.0 ; R_4_joint [rad/s]
      (11,0)  8.0 ; R_5_joint [rad/s]
      (12,0)  0.1 ; R_6_joint [rad/s]
      (13,0)  8.0 ; R_7_joint [rad/s]
    }
  }
}
