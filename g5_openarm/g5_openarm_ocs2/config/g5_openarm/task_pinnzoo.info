; g5_openarm conservative startup config with PinnZoo-backed wheel-based dynamics
; Goal: keep the original RViz / target / MRT workflow, but source the reduced flow map
; from the generated PinnZoo library in /root/pinnzoo_link.

model_information {
  manipulatorModelType 1

  removeJoints {
    [0]  "AMR_FL_joint"
    [1]  "AMR_FLW_joint"
    [2]  "AMR_FR_joint"
    [3]  "AMR_FRW_joint"
    [4]  "AMR_RL_joint"
    [5]  "AMR_RLW_joint"
    [6]  "AMR_RR_joint"
    [7]  "AMR_RRW_joint"
    [8]  "gripper_LL_joint"
    [9]  "gripper_LR_joint"
    [10] "gripper_RL_joint"
    [11] "gripper_RR_joint"
  }

  baseFrame "AMR_base_link"
  ; eeFrame/eeFrame1 should target the tool-center links, not a single finger.
  eeFrame   "L_ee_link"
  eeFrame1  "R_ee_link"
}

model_settings {
  usePreComputation true
  recompileLibraries true
}

pinnzoo {
  enabled true
  validateDynamics true
  ; Export PINNZOO_LIBRARY_PATH before launch, for example:
  ; export PINNZOO_LIBRARY_PATH=/abs/path/to/PinnZoo/build/libg7_openarm_quat.so
  libraryPath "${PINNZOO_LIBRARY_PATH}"
  dynamicsSymbol "dynamics_wrapper"
  velocityKinematicsSymbol "velocity_kinematics_wrapper"
  configOrderSymbol "get_config_order"
  velocityOrderSymbol "get_vel_order"
  torqueOrderSymbol "get_torque_order"
  generatedUrdfPathSymbol "get_urdf_path"
  baseHeight 0.11

  ; Optional overrides for fixed joints in the full PinnZoo configuration.
  ; Omitted joints default to 0.0, which matches the current g5_openarm startup pose.
  fixedJointPositions {
    jointNames {
    }
  }
}

ddp {
  algorithm SLQ

  nThreads 3
  threadPriority 50

  maxNumIterations 2
  minRelCost 0.1
  constraintTolerance 1e-3

  displayInfo false
  displayShortSummary false
  checkNumericalStability false
  debugPrintRollout false
  debugCaching false

  AbsTolODE 1e-5
  RelTolODE 1e-3
  maxNumStepsPerSecond 100000
  timeStep 1e-3
  backwardPassIntegratorType ODE45

  constraintPenaltyInitialValue 20.0
  constraintPenaltyIncreaseRate 2.0

  preComputeRiccatiTerms true
  useFeedbackPolicy false

  strategy LINE_SEARCH
  lineSearch {
    minStepLength 1e-2
    maxStepLength 1.0
    hessianCorrectionStrategy DIAGONAL_SHIFT
    hessianCorrectionMultiple 1e-3
  }
}

rollout {
  AbsTolODE 1e-5
  RelTolODE 1e-3
  timeStep 1e-2
  integratorType ODE45
  maxNumStepsPerSecond 100000
  checkNumericalStability false
}

mpc {
  timeHorizon 0.8
  solutionTimeWindow 0.2
  coldStart false
  debugPrint false
  mpcDesiredFrequency 80
  mrtDesiredFrequency 250
}

initialState {
  base {
    defaultManipulator {
    }

    floatingArmManipulator {
      (0,0) 0.0
      (1,0) 0.0
      (2,0) 0.0
      (3,0) 0.0
      (4,0) 0.0
      (5,0) 0.0
    }

    fullyActuatedFloatingArmManipulator {
      (0,0) 0.0
      (1,0) 0.0
      (2,0) 0.0
      (3,0) 0.0
      (4,0) 0.0
      (5,0) 0.0
    }

    wheelBasedMobileManipulator {
      (0,0) 0.0
      (1,0) 0.0
      (2,0) 0.0
    }
  }

  arm {
    (0,0)   0.0
    (1,0)   0.0
    (2,0)   0.0
    (3,0)   0.0
    (4,0)   0.0
    (5,0)   0.0
    (6,0)   0.0

    (7,0)   0.0
    (8,0)   0.0
    (9,0)   0.0
    (10,0)  0.0
    (11,0)  0.0
    (12,0)  0.0
    (13,0)  0.0
  }
}

inputCost {
  R {
    base {
      defaultManipulator {
      }

      floatingArmManipulator {
      }

      fullyActuatedFloatingArmManipulator {
        scaling 1e-2
        (0,0) 5.0
        (1,1) 5.0
        (2,2) 5.0
        (3,3) 5.0
        (4,4) 5.0
        (5,5) 5.0
      }

      wheelBasedMobileManipulator {
        ; stronger regularization than normal task.info
        scaling 5e-2
        (0,0) 4.0
        (1,1) 4.0
      }
    }

    arm {
      ; stronger regularization than normal task.info
      scaling 5e-2
      (0,0)   2.0
      (1,1)   2.0
      (2,2)   2.0
      (3,3)   2.0
      (4,4)   2.0
      (5,5)   3.0
      (6,6)   2.0
      (7,7)   2.0
      (8,8)   2.0
      (9,9)   2.0
      (10,10) 2.0
      (11,11) 2.0
      (12,12) 3.0
      (13,13) 2.0
    }
  }
}

endEffector {
  dualArmMode true
  leftArm {
    muPosition 8.0
    muOrientation 3.0
  }
  rightArm {
    muPosition 8.0
    muOrientation 3.0
  }
}

finalEndEffector {
  dualArmMode true
  leftArm {
    muPosition 8.0
    muOrientation 3.0
  }
  rightArm {
    muPosition 8.0
    muOrientation 3.0
  }
}

selfCollision {
  activate false
}

jointPositionLimits {
  activate true
  mu 0.01
  delta 1e-3
}

jointVelocityLimits {
  mu 0.01
  delta 1e-3

  lowerBound {
    base {
      defaultManipulator {
      }
      floatingArmManipulator {
      }
      fullyActuatedFloatingArmManipulator {
        (0,0) -0.1
        (1,0) -0.1
        (2,0) -0.1
        (3,0) -0.3
        (4,0) -0.3
        (5,0) -0.3
      }
      wheelBasedMobileManipulator {
        (0,0) -0.4
        (1,0) -0.6
      }
    }

    arm {
      (0,0)  -1.5
      (1,0)  -1.5
      (2,0)  -1.5
      (3,0)  -1.5
      (4,0)  -1.5
      (5,0)  -0.05
      (6,0)  -1.5

      (7,0)  -1.5
      (8,0)  -1.5
      (9,0)  -1.5
      (10,0) -1.5
      (11,0) -1.5
      (12,0) -0.05
      (13,0) -1.5
    }
  }

  upperBound {
    base {
      defaultManipulator {
      }
      floatingArmManipulator {
      }
      fullyActuatedFloatingArmManipulator {
        (0,0) 0.1
        (1,0) 0.1
        (2,0) 0.1
        (3,0) 0.3
        (4,0) 0.3
        (5,0) 0.3
      }
      wheelBasedMobileManipulator {
        (0,0) 0.4
        (1,0) 0.6
      }
    }

    arm {
      (0,0)   1.5
      (1,0)   1.5
      (2,0)   1.5
      (3,0)   1.5
      (4,0)   1.5
      (5,0)   0.05
      (6,0)   1.5

      (7,0)   1.5
      (8,0)   1.5
      (9,0)   1.5
      (10,0)  1.5
      (11,0)  1.5
